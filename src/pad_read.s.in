# hook R: replaces `bl KPADRead` in the game's pad update.
#   r3 = channel, r4 = buffer of 0x88-byte KPADStatus entries, r5 = 10.
#   The caller keeps its per-channel struct in r17 (callee-saved).
#
# Runs the real KPADRead, then rewrites what it returned so that a Classic Controller or a
# GameCube pad looks like a Wii Remote with a Nunchuk plugged in, which is what the game
# wants: buttons, Nunchuk stick, a pointer (the right / C stick), and "gesture" buttons.
#
# KPADStatus fields used (offsets):  0 hold  4 trig  8 release  0x20 pos x/y  0x5c ext type
#   0x60 nunchuk stick x/y (floats)  0x60 classic hold  0x6c/0x74 classic left/right stick
#   0x7c state of ours  0x84 IR-valid count
# Gesture requests are passed to hook G as spare bits in hold/trig:
#   0x20 swing  0x40 shield bash  0x80 spin attack
    stwu    r1, -0x90(r1)
    stmw    r20, 0x30(r1)
    mr      r28, r3                     # channel
    mr      r30, r4                     # buffer
    mr      r29, r17                    # the game's per-channel struct
    lis     r12, KPADREAD@h
    ori     r12, r12, KPADREAD@l
    mtctr   r12
    bctrl
    mr      r31, r3                     # number of samples returned
    cmpwi   r28, 0
    bne     90f                         # the game is single player: only port 1 / channel 0
    bl      1f
1:  mflr    r27
    addi    r27, r27, KT - 1b           # r27 -> constant table

    # ---- is a GameCube pad answering on this port?  r26 = INBUFH, r25 = INBUFL (0 = none)
    li      r26, 0
    li      r25, 0
.if FEED
    lis     r4, FEED@h
    ori     r4, r4, FEED@l
    lwz     r3, 0(r4)
    cmpwi   r3, 1
    bne     5f
    lwz     r26, 4(r4)
    lwz     r25, 8(r4)
    b       6f
5:
.endif
    cmplwi  r28, 3
    bgt     6f
    mulli   r3, r28, 12
    lis     r4, 0xCD00
    add     r4, r4, r3
    lwz     r3, 0x6404(r4)              # SIC0INBUFH
    cmpwi   r3, 0
    blt     6f                          # error / no pad
    andis.  r0, r3, 0x0080
    beq     6f                          # bit 23 is set in every real pad answer
    mr      r26, r3
    lwz     r25, 0x6408(r4)             # SIC0INBUFL
6:
    # ---- dev feed of a Classic Controller (type 2 in the feed block)
    li      r24, 0
.if FEED
    lis     r4, FEED@h
    ori     r4, r4, FEED@l
    lwz     r3, 0(r4)
    cmpwi   r3, 2
    bne     7f
    li      r24, 1
7:
.endif
    # ---- no samples but a pad (or a fed classic): make one up
    cmpwi   r31, 0
    bne     8f
    cmpwi   r26, 0
    bne     4f
    cmpwi   r24, 0
    beq     90f
4:  mr      r3, r30
    li      r4, 0x88 / 4
    mtctr   r4
    li      r0, 0
41: stw     r0, 0(r3)
    addi    r3, r3, 4
    bdnz    41b
    lfs     f0, K_ONE - KT(r27)
    fneg    f1, f0
    stfs    f1, 0x10(r30)               # resting accelerometer: -1 g on y
    stfs    f0, 0x18(r30)
    stfs    f0, 0x34(r30)
    stfs    f0, 0x48(r30)
    stfs    f0, 0x54(r30)
    stfs    f1, 0x6c(r30)
    stfs    f0, 0x74(r30)
    li      r31, 1
8:
.if FEED
    cmpwi   r24, 0
    beq     11f
    lis     r4, FEED@h
    ori     r4, r4, FEED@l
    mulli   r5, r31, 0x88
    add     r5, r5, r30
    mr      r6, r30
12: li      r0, 2
    stw     r0, 0x5c(r6)
    lwz     r0, 16(r4)
    stw     r0, 0x60(r6)
    lwz     r0, 20(r4)
    stw     r0, 0x6c(r6)
    lwz     r0, 24(r4)
    stw     r0, 0x70(r6)
    lwz     r0, 28(r4)
    stw     r0, 0x74(r6)
    lwz     r0, 32(r4)
    stw     r0, 0x78(r6)
    addi    r6, r6, 0x88
    cmplw   r6, r5
    blt     12b
11:
.endif

    # ---- GameCube pad -> wii bits (r20), sticks (f12/f13 stick, f10/f11 C-stick)
    li      r20, 0
    cmpwi   r26, 0
    beq     10f
    srwi    r5, r26, 16                 # PAD button word
    li      r6, 0
@GC_MAP@
    mr      r20, r6
    clrlwi  r3, r26, 24                 # stick Y
    bl      GCCONV
    fmr     f13, f1
    rlwinm  r3, r26, 24, 24, 31         # stick X
    bl      GCCONV
    fmr     f12, f1
    srwi    r3, r25, 24                 # C-stick X
    bl      GCCONV
    fmr     f10, f1
    rlwinm  r3, r25, 16, 24, 31         # C-stick Y
    bl      GCCONV
    fmr     f11, f1
10:
    # ---- pass 1: convert every sample
    lwz     r23, 4(r29)                 # the newest hold of the previous frame (edge baseline)
    lwz     r22, 0x80(r29)              # our per-channel state (kept in the stored sample's spare word)
    li      r21, 0                      # bit i = sample i was converted
    mulli   r24, r31, 0x88
    add     r24, r24, r30
20: addi    r24, r24, -0x88
    cmplw   r24, r30
    blt     39f
    lwz     r6, 0(r24)                  # the Wii Remote's own buttons stay
    lwz     r5, 0x5c(r24)               # extension type of this sample
    cmpwi   r5, 2
    bne     25f
    lwz     r5, 0x60(r24)               # classic buttons
@CC_MAP@
    lwz     r8, 0x6c(r24)               # left stick -> nunchuk stick
    stw     r8, 0x60(r24)
    lwz     r8, 0x70(r24)
    stw     r8, 0x64(r24)
    lfs     f10, 0x74(r24)              # right stick -> pointer
    lfs     f11, 0x78(r24)
    b       28f
25: cmpwi   r26, 0
    beq     20b                         # nothing to do for this sample
    or      r6, r6, r20
    stfs    f12, 0x60(r24)
    stfs    f13, 0x64(r24)
28: li      r5, 1
    stw     r5, 0x5c(r24)               # it is a Nunchuk now
    li      r0, 0
    stb     r0, 0x85(r24)               # the game drops samples with this byte set (real remote, no Nunchuk)
    stw     r6, 0(r24)
    subf    r3, r30, r24
    li      r4, 0x88
    divwu   r3, r3, r4
    li      r4, 1
    slw     r4, r4, r3
    or      r21, r21, r4
    b       20b
39: cmpwi   r21, 0
    beq     90f

    # ---- the newest sample: spin attack (ZR held for a while) and the pointer
    andi.   r0, r21, 1
    beq     41f
    lwz     r6, 0(r30)
    clrlwi  r4, r22, 24                 # frames the swing button has been held
    andi.   r0, r6, 0x20
    beq     42f
    cmplwi  r4, 255
    bge     43f
    addi    r4, r4, 1
43: cmplwi  r4, SPIN_FRAMES
    bne     44f
    ori     r6, r6, 0x80                # one-frame "spin attack" request
44: b       45f
42: li      r4, 0
45: rlwimi  r22, r4, 0, 24, 31
    stw     r6, 0(r30)
    stw     r22, 0x7c(r30)
41:
    lfs     f1, 0x24(r29)               # pointer: last frame's position (the game scales it by 1.1)
    lfs     f2, 0x28(r29)
    lfs     f3, K_UNSCALE - KT(r27)
    fmuls   f1, f1, f3
    fmuls   f2, f2, f3
    lfs     f4, K_DZ_CC - KT(r27)
    lfs     f5, K_ZERO - KT(r27)
    lfs     f6, K_STEP - KT(r27)
    fabs    f7, f10
    fsubs   f7, f7, f4
    fsel    f10, f7, f10, f5
    fabs    f7, f11
    fsubs   f7, f7, f4
    fsel    f11, f7, f11, f5
    fmadds  f1, f10, f6, f1             # x += stick x
    fnmsubs f2, f11, f6, f2             # y -= stick y (screen y points down)
    lfs     f7, K_ONE - KT(r27)
    fneg    f8, f7
    fsubs   f9, f1, f7
    fsel    f1, f9, f7, f1
    fsubs   f9, f1, f8
    fsel    f1, f9, f1, f8
    lfs     f7, K_YMAX - KT(r27)
    fneg    f8, f7
    fsubs   f9, f2, f7
    fsel    f2, f9, f7, f2
    fsubs   f9, f2, f8
    fsel    f2, f9, f2, f8

    # ---- pass 2: edges, pointer
    mr      r20, r23                    # previous frame's newest hold
    addi    r9, r31, -1
50: cmpwi   r9, 0
    blt     59f
    mulli   r10, r9, 0x88
    add     r10, r10, r30
    lwz     r6, 0(r10)
    srw     r3, r21, r9
    andi.   r3, r3, 1
    beq     55f
    mr      r7, r23                     # edges against the previous sample...
    cmpwi   r9, 0
    bne     56f
    mr      r7, r20                     # ...but the newest one against the previous frame, so a press
56: andc    r4, r6, r7                  #    that landed on an older sample is not lost
    stw     r4, 4(r10)                  # trig
    andc    r5, r7, r6
    stw     r5, 8(r10)                  # release
    stfs    f1, 0x20(r10)
    stfs    f2, 0x24(r10)
    li      r4, 2
    stb     r4, 0x84(r10)               # the pointer is on screen
55: mr      r23, r6
    addi    r9, r9, -1
    b       50b
59:
.if FEED
    lis     r6, FEED@h
    ori     r6, r6, FEED@l
    lwz     r7, 0x54(r6)
    addi    r7, r7, 1
    stw     r7, 0x54(r6)                # R calls that converted something
    lwz     r3, 4(r30)
    andi.   r0, r3, 0x20
    beq     57f
    lwz     r7, 0x50(r6)
    addi    r7, r7, 1
    stw     r7, 0x50(r6)                # ...and had a swing trig on the newest sample
57:
.endif
90: mr      r3, r31
    lmw     r20, 0x30(r1)
    addi    r1, r1, 0x90
    b       99f

# r3 = a pad axis byte (128 = centre) -> f1 = -1.0 .. 1.0 with a dead zone.  Uses r0, r3, f1-f6.
GCCONV:
    addi    r3, r3, -128
    lis     r0, 0x4330
    stw     r0, 0x20(r1)
    xoris   r3, r3, 0x8000
    stw     r3, 0x24(r1)
    lfd     f1, 0x20(r1)
    lfd     f2, 0(r27)
    fsub    f1, f1, f2
    frsp    f1, f1
    lfs     f2, K_GCSCALE - KT(r27)
    fmuls   f1, f1, f2
    lfs     f2, K_ONE - KT(r27)
    fneg    f3, f2
    fsubs   f4, f1, f2
    fsel    f1, f4, f2, f1
    fsubs   f4, f1, f3
    fsel    f1, f4, f1, f3
    fabs    f4, f1
    lfs     f5, K_DZ_GC - KT(r27)
    fsubs   f4, f4, f5
    lfs     f6, K_ZERO - KT(r27)
    fsel    f1, f4, f1, f6
    blr

    .balign 8
KT:
    .long   0x43300000, 0x80000000      # 2^52 + 2^31 (int -> float)
    .set    K_ONE, KT + 8
    .float  1.0
    .set    K_ZERO, KT + 12
    .float  0.0
    .set    K_GCSCALE, KT + 16
    .float  0.0111111
    .set    K_DZ_GC, KT + 20
    .float  0.14
    .set    K_DZ_CC, KT + 24
    .float  0.12
    .set    K_STEP, KT + 28
    .float  0.025
    .set    K_YMAX, KT + 32
    .float  0.55
    .set    K_UNSCALE, KT + 36
    .float  0.9090909
99:
